+def _rlpb_logprob_chunk(lm_head, hidden_chunk, target_chunk, softcap, temperature):
+    """One lm_head chunk. Matmul dtype matches compute_lm_head_logits; log_softmax stays fp32."""
+    # Tied lm_head is not FSDP-wrapped, so the fp32 hidden is not cast for us.
+    compute_dtype = None
+    get_state = getattr(lm_head, "_get_fsdp_state", None)
+    if get_state is not None:
+        compute_dtype = get_state()._mp_policy.param_dtype
+    weight = getattr(lm_head, "weight", None)
+    if compute_dtype is None and isinstance(weight, torch.Tensor):
+        compute_dtype = weight.dtype
+    if compute_dtype is not None and hidden_chunk.dtype != compute_dtype:
+        hidden_chunk = hidden_chunk.to(compute_dtype)
+    logits = lm_head(hidden_chunk)
+    if softcap is not None:
+        logits = torch.tanh(logits / softcap) * softcap
+    if temperature is not None and float(temperature) != 1.0:
+        logits = logits / float(temperature)
+    logits = logits.float()
+    log_probs = torch.log_softmax(logits, dim=-1)
+    index = target_chunk.to(device=log_probs.device, dtype=torch.long).unsqueeze(-1)
+    return log_probs.gather(dim=-1, index=index).squeeze(-1)
+
+
+def _rlpb_chunked_logprobs(lm_head, hidden, targets, softcap, chunk_size, temperature):
+    # RL_Pinchbench: chunked lm_head. Never materialize [B, S, vocab] fp32 logits.
+    if hidden.dim() != 3:
+        raise RuntimeError(f"RL_Pinchbench lm_head chunk expected [B, S, H], got {tuple(hidden.shape)}")
+    if hidden.shape[1] != targets.shape[1]:
+        raise RuntimeError(
+            f"RL_Pinchbench lm_head chunk length hidden={hidden.shape[1]} targets={targets.shape[1]}"
+        )
+    # 1024 token * 262144 * 4 B = 1 GiB. Backward also holds the grad of that chunk.
+    step = max(1, min(int(chunk_size or 1024), 1024))
+    pieces = []
+    for start in range(0, hidden.shape[1], step):
+        end = min(hidden.shape[1], start + step)
+        hidden_chunk = hidden[:, start:end, :]
+        target_chunk = targets[:, start:end]
+        if torch.is_grad_enabled() and hidden_chunk.requires_grad:
+            def _run(h, t, _lm=lm_head, _cap=softcap, _temp=temperature):
+                return _rlpb_logprob_chunk(_lm, h, t, _cap, _temp)
+            pieces.append(
+                torch.utils.checkpoint.checkpoint(_run, hidden_chunk, target_chunk, use_reentrant=False)
+            )
+        else:
+            pieces.append(
+                _rlpb_logprob_chunk(lm_head, hidden_chunk, target_chunk, softcap, temperature)
+            )
+    return torch.cat(pieces, dim=1) if len(pieces) > 1 else pieces[0]
+
