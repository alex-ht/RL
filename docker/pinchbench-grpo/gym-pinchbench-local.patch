+"""Tests for the container-less `sandbox_provider: {local: {...}}` mode and
+judge-failure masking."""
+
+import json
+import os
+import textwrap
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+
+from nemo_gym.server_utils import ServerClient
+from responses_api_agents.pinchbench import app as pb_app
+from responses_api_agents.pinchbench.app import (
+    PinchBenchAgent,
+    PinchBenchAgentConfig,
+    resolve_local_work_root,
+)
+
+
+@pytest.fixture
+def allow_tmp(monkeypatch):
+    # pytest's tmp_path lives under /tmp, which the local provider refuses on purpose.
+    monkeypatch.setattr(pb_app, "_TMP_PREFIXES", ())
+
+
+def make_agent(**over) -> PinchBenchAgent:
+    base = dict(
+        name="pinchbench",
+        host="0.0.0.0",
+        port=0,
+        entrypoint="app.py",
+        model_base_url="http://policy/v1",
+        model_api_key="EMPTY",
+        model_name="gemma4",
+        judge_model="gpt-5.4-mini",
+        judge_base_url="https://judge.example/openai/v1",
+        judge_api_key="sk-judge",
+        judge_fallback_model="gpt-5.4",
+        web_search_provider="tavily",
+        tavily_api_key="tvly-test",
+        sandbox_provider={"local": {}},
+        context_window=65536,
+        max_tokens=16384,
+        web_fetch_max_chars=12000,
+        sampling_params={"temperature": 1.0, "top_p": 0.95, "top_k": 64},
+    )
+    base.update(over)
+    return PinchBenchAgent(config=PinchBenchAgentConfig(**base), server_client=MagicMock(spec=ServerClient))
+
+
+def _write_script(path: Path, body: str) -> Path:
+    path.write_text("#!/usr/bin/env bash\nset -u\n" + textwrap.dedent(body))
+    path.chmod(0o755)
+    return path
+
+
+def test_local_provider_config_needs_no_image():
+    agent = make_agent(sandbox_spec={"image": "/does/not/exist.sqsh"})
+    assert "local" in agent.config.sandbox_provider
+
+
+def test_resolve_local_work_root_rejects_tmp(monkeypatch):
+    for name in ("PINCHBENCH_GYM_WORK_ROOT", "PINCHBENCH_WORKDIR", "SLURM_TMPDIR", "SLURM_JOB_ID"):
+        monkeypatch.delenv(name, raising=False)
+    with pytest.raises(ValueError):
+        resolve_local_work_root("/tmp/pinchbench-should-not-be-used")
+
+
+def test_resolve_local_work_root_env_order(tmp_path, monkeypatch, allow_tmp):
+    monkeypatch.delenv("PINCHBENCH_GYM_WORK_ROOT", raising=False)
+    monkeypatch.setenv("PINCHBENCH_WORKDIR", str(tmp_path / "pbw"))
+    monkeypatch.setenv("SLURM_TMPDIR", str(tmp_path / "slurm"))
+    assert resolve_local_work_root() == (tmp_path / "pbw" / "gym").resolve()
+
+
+def test_task_env_forwards_experiment_knobs():
+    env = make_agent()._task_env("task_stock")
+    assert env["PINCHBENCH_CONTEXT_WINDOW"] == "65536"
+    assert env["PINCHBENCH_WEB_FETCH_MAX_CHARS"] == "12000"
+    assert env["JUDGE_FALLBACK_MODEL"] == "gpt-5.4"
+    assert env["TAVILY_API_KEY"] == "tvly-test"
+    assert env["PINCHBENCH_WEB_SEARCH_PROVIDER"] == "tavily"
+    assert json.loads(env["PINCHBENCH_SAMPLING_PARAMS"])["top_k"] == 64
+
+
+@pytest.mark.asyncio
+async def test_run_local_isolates_and_collects(tmp_path, monkeypatch, allow_tmp):
+    script = _write_script(
+        tmp_path / "fake_run_task.sh",
+        """
+        out="$PINCHBENCH_WORK_BASE/out"; mkdir -p "$out"
+        # leave a straggler behind; the agent must reap the process group
+        (sleep 300 &) ; echo $$ > "$PINCHBENCH_WORK_BASE/pid"
+        python3 - <<'PY'
+        import json, os
+        assert os.environ["PINCHBENCH_WORK_BASE"]
+        assert "OPENCLAW_GATEWAY_TOKEN" not in os.environ
+        out = os.path.join(os.environ["PINCHBENCH_WORK_BASE"], "out")
+        json.dump({"tasks": [{"task_id": os.environ["TASK_ID"], "grading": {"mean": 0.75,
+                   "runs": [{"grading_type": "hybrid", "breakdown": {}, "notes": "", "judge_failed": False}]}}]},
+                  open(os.path.join(out, "results.json"), "w"))
+        json.dump(dict(os.environ), open(os.path.join(out, "env.txt"), "w"))
+        PY
+        """,
+    )
+    agent = make_agent(
+        sandbox_provider={"local": {"work_root": str(tmp_path / "root"), "run_task_script": str(script)}},
+        work_root=str(tmp_path / "work"),
+        transcripts_dir=str(tmp_path / "tx"),
+    )
+    out_dir = tmp_path / "work" / "r1"
+    out_dir.mkdir(parents=True)
+    rc = await agent._run_local("task_stock", out_dir, agent.config.sandbox_provider["local"])
+    assert rc is None
+    env = json.loads((out_dir / "env.txt").read_text())
+    assert env["TASK_ID"] == "task_stock"
+    assert env["MODEL_BASE_URL"] == "http://policy/v1"
+    assert env["PINCHBENCH_WORK_BASE"].startswith(str((tmp_path / "root").resolve()))
+    result = agent._parse_result("task_stock", out_dir)
+    assert result["reward"] == 0.75 and result["judge_failed"] is False
+    # per-rollout dir is removed unless keep_workdirs
+    assert not any((tmp_path / "root" / "rollouts").iterdir())
+
+
+@pytest.mark.asyncio
+async def test_run_local_failure_without_results_raises(tmp_path, allow_tmp):
+    script = _write_script(tmp_path / "fail.sh", 'mkdir -p "$PINCHBENCH_WORK_BASE/out"; echo boom > "$PINCHBENCH_WORK_BASE/out/run.log"; exit 4\n')
+    agent = make_agent(sandbox_provider={"local": {"work_root": str(tmp_path / "root"), "run_task_script": str(script)}})
+    with pytest.raises(RuntimeError, match="boom"):
+        await agent._run_local("task_x", tmp_path / "o", agent.config.sandbox_provider["local"])
+
+
+@pytest.mark.asyncio
+async def test_run_local_timeout(tmp_path, allow_tmp):
+    script = _write_script(tmp_path / "slow.sh", "sleep 30\n")
+    agent = make_agent(
+        task_timeout_s=1,
+        sandbox_provider={"local": {"work_root": str(tmp_path / "root"), "run_task_script": str(script)}},
+    )
+    with pytest.raises(TimeoutError):
+        await agent._run_local("task_x", tmp_path / "o", agent.config.sandbox_provider["local"])
+
+
+@pytest.mark.asyncio
+async def test_judge_failure_masks_sample(tmp_path, monkeypatch, allow_tmp):
+    agent = make_agent(
+        sandbox_provider={"local": {"work_root": str(tmp_path / "root")}},
+        work_root=str(tmp_path / "work"),
+        transcripts_dir=str(tmp_path / "tx"),
+    )
+
+    async def ok(task_id, out_dir, rollout_id=None):
+        (out_dir / "results.json").write_text(json.dumps({"tasks": [{"task_id": task_id, "grading": {
+            "mean": 0.0, "runs": [{"grading_type": "llm_judge", "breakdown": {}, "notes": "LLM judge failed", "judge_failed": True}]}}]}))
+        return None
+
+    monkeypatch.setattr(agent, "_run_in_sandbox", ok)
+    body = MagicMock()
+    body.model_dump.return_value = {
+        "responses_create_params": {"input": [{"role": "user", "content": "hi"}]},
+        "verifier_metadata": {"task_id": "task_events"},
+    }
+    resp = (await agent.run(body=body)).model_dump()
+    assert resp["instance_config"]["mask_sample"] is True
+    assert resp["status"] == "judge_failed"
+
+
+@pytest.mark.asyncio
+async def test_judge_failure_mask_can_be_disabled(tmp_path, monkeypatch, allow_tmp):
+    agent = make_agent(mask_on_judge_failure=False, work_root=str(tmp_path / "work"), transcripts_dir=str(tmp_path / "tx"))
+
+    async def ok(task_id, out_dir, rollout_id=None):
+        (out_dir / "results.json").write_text(json.dumps({"tasks": [{"task_id": task_id, "grading": {
+            "mean": 0.0, "runs": [{"grading_type": "llm_judge", "judge_failed": True}]}}]}))
+
+    monkeypatch.setattr(agent, "_run_in_sandbox", ok)
+    body = MagicMock()
+    body.model_dump.return_value = {"responses_create_params": {"input": "x"}, "verifier_metadata": {"task_id": "t"}}
+    resp = (await agent.run(body=body)).model_dump()
+    assert "mask_sample" not in (resp.get("instance_config") or {})
