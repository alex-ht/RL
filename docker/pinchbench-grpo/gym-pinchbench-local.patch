+#                     $SLURM_SUBMIT_DIR/.pinchbench-work/job-$SLURM_JOB_ID/gym). Never /tmp.
+#   run_task_script:  default <this dir>/run_task_local.sh
+#   skill_dir:        PinchBench skill checkout (default $PINCHBENCH_SKILL_DIR or /opt/pinchbench)
+#   python:           interpreter for benchmark.py (default $PINCHBENCH_PYTHON or python3)
+#   inherit_env:      extra env var names to pass through from this server
+#   keep_workdirs:    keep per-rollout dirs for debugging (default false)
+LOCAL_PROVIDER = "local"
+_LOCAL_INHERIT_ENV = (
+    "PATH", "LANG", "LC_ALL", "LC_CTYPE", "TZ", "USER", "LOGNAME", "SHELL",
+    "SSL_CERT_FILE", "SSL_CERT_DIR", "REQUESTS_CA_BUNDLE", "CURL_CA_BUNDLE", "NODE_EXTRA_CA_CERTS",
+    "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "http_proxy", "https_proxy", "no_proxy", "ALL_PROXY",
+    "GWS_SOURCE_CONFIG_DIR", "PLAYWRIGHT_BROWSERS_PATH", "GH_TOKEN", "NODE_OPTIONS", "NODE_PATH",
+    "SLURM_JOB_ID", "SLURM_PROCID", "SLURMD_NODENAME",
+)
+_TMP_PREFIXES = ("/tmp", "/var/tmp")
+
+
+def _is_under_tmp(path: Path) -> bool:
+    resolved = str(path.resolve())
+    return any(resolved == p or resolved.startswith(p + "/") for p in _TMP_PREFIXES)
+
+
+def resolve_local_work_root(explicit: Optional[str] = None) -> Path:
+    """Pick the per-rollout work root for the local provider (never /tmp)."""
+    candidates: list[Path] = []
+    if explicit:
+        candidates.append(Path(explicit).expanduser())
+    for env_name, suffix in (
+        ("PINCHBENCH_GYM_WORK_ROOT", ""),
+        ("PINCHBENCH_WORKDIR", "gym"),
+        ("SLURM_TMPDIR", "pinchbench/gym"),
+    ):
+        value = (os.environ.get(env_name) or "").strip()
+        if value:
+            candidates.append(Path(value) / suffix if suffix else Path(value))
+    job_id = (os.environ.get("SLURM_JOB_ID") or "").strip()
+    if job_id:
+        submit = (os.environ.get("SLURM_SUBMIT_DIR") or os.getcwd()).strip()
+        candidates.append(Path(submit) / ".pinchbench-work" / f"job-{job_id}" / "gym")
+    for cand in candidates:
+        if _is_under_tmp(cand):
+            LOG.warning("pinchbench local work_root candidate under /tmp rejected: %s", cand)
+            continue
+        try:
+            cand.mkdir(parents=True, exist_ok=True)
+        except OSError:
+            continue
+        if os.access(cand, os.W_OK | os.X_OK):
+            return cand.resolve()
+    raise ValueError(
+        "pinchbench local provider: no writable work_root (set sandbox_provider.local.work_root, "
+        "PINCHBENCH_GYM_WORK_ROOT or PINCHBENCH_WORKDIR to a non-/tmp directory)"
+    )
+
 
