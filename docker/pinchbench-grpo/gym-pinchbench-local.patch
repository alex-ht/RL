@@ -0,0 +1,191 @@
+#!/usr/bin/env bash
+# Local (container-less) PinchBench task runner for the pinchbench agent's
+# `sandbox_provider: {local: {...}}` mode. Used where no per-task container
+# runtime exists (SLURM + enroot/Pyxis: no apptainer, no docker): the Gym
+# agent server, already running INSIDE the training container, launches this
+# script as a plain subprocess per rollout.
+#
+# Isolation boundary = a private per-rollout directory ($PINCHBENCH_WORK_BASE):
+# HOME, OPENCLAW_STATE_DIR, TMPDIR, PINCHBENCH_WORKDIR (benchmark run-root,
+# judge workspaces), caches, fws/gh state all live there, so concurrent
+# rollouts never share OpenClaw state. Nothing is written to /tmp or to the
+# (read-only) image. OpenClaw runs embedded (`openclaw agent --local`, done by
+# the skill fork's lib_agent), so no gateway process/port is needed.
+#
+# Required env:
+#   PINCHBENCH_WORK_BASE  per-rollout dir (must NOT be under /tmp)
+#   TASK_ID MODEL_NAME MODEL_BASE_URL JUDGE_MODEL JUDGE_BASE_URL JUDGE_API_KEY
+# Optional env:
+#   MODEL_API_KEY (default EMPTY)        PINCHBENCH_SKILL_DIR (default /opt/pinchbench)
+#   PINCHBENCH_PYTHON (default python3)  JUDGE_FALLBACK_MODEL
+#   PINCHBENCH_CONTEXT_WINDOW (65536)    PINCHBENCH_MAX_TOKENS (16384)
+#   PINCHBENCH_WEB_SEARCH_PROVIDER (tavily) + TAVILY_API_KEY / BRAVE_API_KEY
+#   PINCHBENCH_WEB_FETCH_MAX_CHARS (12000)
+#   PINCHBENCH_SAMPLING_PARAMS  JSON merged into the model's request params
+#                               (default temperature=1, top_p=0.95, top_k=64;
+#                               a null value drops a default key)
+#   PINCHBENCH_MAX_TOKENS_FIELD (max_tokens; e.g. max_completion_tokens for Azure)
+#   PINCHBENCH_MODEL_REASONING (0)  1 = mark the model "reasoning": true in OpenClaw
+#   PINCHBENCH_THINKING        OpenClaw --thinking level (unset = default)
+#   PINCHBENCH_PROVIDER_TIMEOUT_SECONDS PINCHBENCH_AGENT_TIMEOUT_SECONDS
+#   PINCHBENCH_STUCK_SESSION_ABORT_SECONDS PINCHBENCH_PROVIDER_HEADERS (JSON)
+#   PINCHBENCH_AGENT_PATH_PREFIX (default /usr/local/bin:/usr/bin, prepended to PATH)
+#   TIMEOUT_MULT (default 3)   PINCHBENCH_VERBOSE=1
+# Output: results JSON + transcripts in $PINCHBENCH_WORK_BASE/out (run.log too).
+set -uo pipefail
+
+: "${PINCHBENCH_WORK_BASE:?run_task_local.sh needs PINCHBENCH_WORK_BASE}"
+: "${TASK_ID:?}" "${MODEL_NAME:?}" "${MODEL_BASE_URL:?}" "${JUDGE_MODEL:?}" "${JUDGE_BASE_URL:?}"
+BASE="$(mkdir -p "$PINCHBENCH_WORK_BASE" && cd "$PINCHBENCH_WORK_BASE" && pwd -P)"
+case "$BASE" in
+  /tmp|/tmp/*|/var/tmp|/var/tmp/*)
+    echo "[run_task_local] refusing PINCHBENCH_WORK_BASE under /tmp: $BASE" >&2; exit 2 ;;
+esac
+
+SKILL="${PINCHBENCH_SKILL_DIR:-/opt/pinchbench}"
+PY="${PINCHBENCH_PYTHON:-python3}"
+OUT="$BASE/out"
+WORK="$BASE/work"
+
+export HOME="$BASE/home"
+export OPENCLAW_STATE_DIR="$HOME/.openclaw"
+export PINCHBENCH_WORKDIR="$BASE/pb"
+export PINCHBENCH_RUN_ROOT="$PINCHBENCH_WORKDIR/runs"
+export PINCHBENCH_LOG_DIR="$OUT"
+export TMPDIR="$BASE/tmp" TMP="$BASE/tmp" TEMP="$BASE/tmp"
+export XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share" XDG_CACHE_HOME="$BASE/cache"
+export NPM_CONFIG_CACHE="$BASE/cache/npm" NPM_CONFIG_UPDATE_NOTIFIER=false NO_UPDATE_NOTIFIER=1
+export FWS_DATA_DIR="$BASE/fws" GH_CONFIG_DIR="$BASE/gh" GH_NO_UPDATE_NOTIFIER=1 GH_PROMPT_DISABLED=1
+export UV_CACHE_DIR="${UV_CACHE_DIR_OVERRIDE:-$BASE/cache/uv}"
+export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
+# The agent's exec tool should see the system python (task deps) rather than a
+# training venv that may be first on PATH in the training image.
+_pb_prefix="${PINCHBENCH_AGENT_PATH_PREFIX-/usr/local/bin:/usr/bin}"   # set empty to disable
+[[ -n "$_pb_prefix" ]] && export PATH="$_pb_prefix:$PATH"
+export PINCHBENCH_ENV_DONE=1   # paths already isolated; do not let pinchbench_env.sh re-resolve
+mkdir -p "$OUT" "$WORK" "$OPENCLAW_STATE_DIR" "$PINCHBENCH_RUN_ROOT" "$TMPDIR" \
+  "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$FWS_DATA_DIR" "$GH_CONFIG_DIR"
+
+# Detach this script and every descendant (OpenClaw tool subprocesses can
+# outlive it) from the parent's pipes; the agent reads run.log on failure.
+exec >"$OUT/run.log" 2>&1
+
+export MODEL_API_KEY="${MODEL_API_KEY:-EMPTY}"
+export OPENAI_API_KEY="${OPENAI_API_KEY:-$MODEL_API_KEY}"
+export JUDGE_API_KEY="${JUDGE_API_KEY:-${AZURE_OPENAI_API_KEY:-}}"
+export PINCHBENCH_WEB_SEARCH_PROVIDER="${PINCHBENCH_WEB_SEARCH_PROVIDER:-tavily}"
+export PINCHBENCH_WEB_FETCH_MAX_CHARS="${PINCHBENCH_WEB_FETCH_MAX_CHARS:-12000}"
+
+# Seed OpenClaw config: one "custom" OpenAI-compatible provider pointing at the
+# policy endpoint (NeMo Gym token-capture URL during RL), with the context
+# window / max tokens / sampling params the experiment fixes. benchmark.py is
+# then given --model custom/<MODEL_NAME>, which lib_agent resolves from here.
+"$PY" - <<'PYCFG' || { echo "[run_task_local] failed to write openclaw.json"; exit 3; }
+import json, os
+from pathlib import Path
+
+cfg_path = Path(os.environ["OPENCLAW_STATE_DIR"]) / "openclaw.json"
+try:
+    cfg = json.loads(cfg_path.read_text("utf-8-sig")) if cfg_path.exists() else {}
+except Exception:
+    cfg = {}
+
+def env_int(name, default):
+    v = os.environ.get(name, "").strip()
+    return int(v) if v else default
+
+model_id = os.environ["MODEL_NAME"]
+max_tokens = env_int("PINCHBENCH_MAX_TOKENS", 16384)
+context_window = env_int("PINCHBENCH_CONTEXT_WINDOW", 65536)
+params = {
+    "temperature": 1.0,
+    "top_p": 0.95,
+    "top_k": 64,
+    # Keep Gemma-4 channel/thinking markers in the returned text so OpenClaw
+    # replays them verbatim on the next tool turn (thinking continuity and
+    # token-capture prefix contiguity).
+    "skip_special_tokens": False,
+    "chat_template_kwargs": {"enable_thinking": True},
+    "maxTokens": max_tokens,
+    "max_tokens": max_tokens,
+}
+if os.environ.get("PINCHBENCH_SAMPLING_PARAMS"):
+    params.update(json.loads(os.environ["PINCHBENCH_SAMPLING_PARAMS"]))
+    # a null value removes a default (e.g. top_k for endpoints that reject it)
+    params = {k: v for k, v in params.items() if v is not None}
+provider = {
+    "baseUrl": os.environ["MODEL_BASE_URL"].rstrip("/"),
+    "apiKey": os.environ.get("MODEL_API_KEY") or "EMPTY",
+    "api": "openai-completions",
+    "models": [{
+        "id": model_id,
+        "name": model_id,
+        "input": ["text"],
+        "reasoning": os.environ.get("PINCHBENCH_MODEL_REASONING", "0") == "1",
+        "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
+        "contextWindow": context_window,
+        "contextTokens": context_window,
+        "maxTokens": max_tokens,
+        "params": params,
+        "compat": {
+            "requiresStringContent": True,
+            "supportsUsageInStreaming": True,
+            "maxTokensField": os.environ.get("PINCHBENCH_MAX_TOKENS_FIELD", "max_tokens"),
+        },
+    }],
+}
+if os.environ.get("PINCHBENCH_PROVIDER_TIMEOUT_SECONDS"):
+    provider["timeoutSeconds"] = int(os.environ["PINCHBENCH_PROVIDER_TIMEOUT_SECONDS"])
+if os.environ.get("PINCHBENCH_PROVIDER_HEADERS"):
+    provider["headers"] = json.loads(os.environ["PINCHBENCH_PROVIDER_HEADERS"])
+models = cfg.setdefault("models", {})
+models["mode"] = "merge"
+models.setdefault("providers", {})["custom"] = provider
+defaults = cfg.setdefault("agents", {}).setdefault("defaults", {})
+ref = f"custom/{model_id}"
+defaults.setdefault("models", {})[ref] = {"params": params}
+defaults.setdefault("model", {})["primary"] = ref
+if os.environ.get("PINCHBENCH_AGENT_TIMEOUT_SECONDS"):
+    defaults["timeoutSeconds"] = int(os.environ["PINCHBENCH_AGENT_TIMEOUT_SECONDS"])
+if os.environ.get("PINCHBENCH_STUCK_SESSION_ABORT_SECONDS"):
+    cfg.setdefault("diagnostics", {})["stuckSessionAbortMs"] = int(os.environ["PINCHBENCH_STUCK_SESSION_ABORT_SECONDS"]) * 1000
+web = cfg.setdefault("tools", {}).setdefault("web", {})
+web.setdefault("search", {}).update({"enabled": True, "provider": os.environ["PINCHBENCH_WEB_SEARCH_PROVIDER"]})
+web.setdefault("fetch", {})["maxChars"] = int(os.environ["PINCHBENCH_WEB_FETCH_MAX_CHARS"])
+# OpenClaw's file log defaults to /tmp/openclaw/openclaw-<date>.log (ignores TMPDIR).
+cfg.setdefault("logging", {})["file"] = os.path.join(os.environ["PINCHBENCH_LOG_DIR"], "openclaw.log")
+cfg_path.parent.mkdir(parents=True, exist_ok=True)
+cfg_path.write_text(json.dumps(cfg, indent=2, ensure_ascii=False), "utf-8")
+os.chmod(cfg_path, 0o600)
+PYCFG
+
+cd "$WORK"
+args=(
+  --model "custom/$MODEL_NAME"
+  --judge "$JUDGE_MODEL"
+  --judge-base-url "$JUDGE_BASE_URL"
+  --suite "$TASK_ID"
+  --no-upload --no-fail-fast --no-judge-cache
+  --timeout-multiplier "${TIMEOUT_MULT:-3}"
+  --output-dir "$OUT"
+)
+[[ -n "${JUDGE_FALLBACK_MODEL:-}" ]] && args+=(--judge-fallback "$JUDGE_FALLBACK_MODEL")
+[[ -n "${PINCHBENCH_THINKING:-}" ]] && args+=(--thinking "$PINCHBENCH_THINKING")
+[[ "${PINCHBENCH_VERBOSE:-0}" == "1" ]] && args+=(--verbose)
+
+echo "[run_task_local] task=$TASK_ID model=custom/$MODEL_NAME base=$BASE skill=$SKILL $(openclaw --version 2>/dev/null)"
+"$PY" "$SKILL/scripts/benchmark.py" "${args[@]}"
+rc=$?
+
+if [[ "${NEMO_GYM_OBSERVABILITY_ENABLED:-0}" == "1" ]]; then
+  # Agent dirs also hold credentials; keep only session metadata + transcripts.
+  for sessions_dir in "$OPENCLAW_STATE_DIR"/agents/*/sessions; do
+    [[ -d "$sessions_dir" ]] || continue
+    agent_id=$(basename "$(dirname "$sessions_dir")")
+    dest="$OUT/openclaw_sessions/agents/$agent_id"
+    mkdir -p "$dest"
+    cp -a "$sessions_dir" "$dest/" 2>/dev/null || true
+  done
+fi
+echo "[run_task_local] benchmark.py exit=$rc"
+exit "$rc"
